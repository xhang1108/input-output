    # Vector Split Test CGL
    # 測試 Vector Split (AD-09) 的兩種模式

    # 1. 拆分模式 (Separate Mode)
    v1:io:matrix = [10, 20, 30]
    splitter_sep:linearalgebra:SEPARATE

    # 連接 v1 到拆分器
    v1 -> splitter_sep:in

    # 顯示 X, Y, Z 的結果
    res_x:io:res
    res_y:io:res
    res_z:io:res自己建立matrix 1想input 還是沒有答案出來
    splitter_sep:x -> res_x
    splitter_sep:y -> res_y
    splitter_sep:z -> res_z

    # 2. 組合模式 (Combine Mode)
    in_x:io:num = 5
    in_y:io:num = 6
    in_z:io:num = 7
    splitter_comb:linearalgebra:COMBINE

    # 連接輸入到組合器
    in_x -> splitter_comb:x
    in_y -> splitter_comb:y
    in_z -> splitter_comb:z

    # 顯示組合後的向量結果
    res_comb:io:res
    splitter_comb -> res_comb
