# Benchmark: Calculus & Symbolic (CL-01 to CL-05)

Formula:io:expr @0,0 = "x^3 - 4*x^2 + 6*x - 3"

D1:calculus:diff @300,0 = "x"
Formula -- D1:expr

D2:calculus:diff @600,0 = "x"
D1 -- D2:expr

Int:calculus:int @300,200 = "definite"
Formula -- Int:expr
L0:io:num @0,200 = "0"
L2:io:num @0,300 = "2"
L0 -- Int:from
L2 -- Int:to

Lim:calculus:lim @300,400 = "0"
Formula -- Lim:expr

Eq:io:expr @0,600 = "x^2 - 4 = 0"
Solve:calculus:solve @300,600 = "x"
Eq -- Solve:in_a

Res_D2:output:res @900,0
Res_Int:output:res @600,200
Res_Lim:output:res @600,400
Res_Solve:output:res @600,600

D2 -- Res_D2:in
Int -- Res_Int:in
Lim -- Res_Lim:in
Solve -- Res_Solve:in
