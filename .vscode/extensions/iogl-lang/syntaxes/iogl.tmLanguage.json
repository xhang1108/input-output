{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "IOGL",
  "scopeName": "source.iogl",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#node_declaration"
    },
    {
      "include": "#wiring"
    },
    {
      "include": "#coordinates"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.iogl",
          "match": "#.*$"
        }
      ]
    },
    "node_declaration": {
      "patterns": [
        {
          "name": "meta.node.iogl",
          "match": "(\\[[^\\]]+\\])?\\s*([A-Z]{2}-\\d{2})",
          "captures": {
            "1": {
              "name": "string.other.label.iogl"
            },
            "2": {
              "name": "entity.name.type.node.iogl"
            }
          }
        },
        {
          "name": "meta.props.iogl",
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            {
              "include": "source.json"
            }
          ]
        }
      ]
    },
    "wiring": {
      "patterns": [
        {
          "match": "(\\[[^\\]]+\\]|[a-zA-Z0-9_\\-\\.]+)\\.([a-z_][a-z0-9_]*)\\s*(->)\\s*(\\[[^\\]]+\\]|[a-zA-Z0-9_\\-\\.]+)\\.([a-z_][a-z0-9_]*)",
          "captures": {
            "1": {
              "name": "variable.other.source.iogl"
            },
            "2": {
              "name": "variable.language.handle.iogl"
            },
            "3": {
              "name": "keyword.control.arrow.iogl"
            },
            "4": {
              "name": "variable.other.target.iogl"
            },
            "5": {
              "name": "variable.language.handle.iogl"
            }
          }
        }
      ]
    },
    "coordinates": {
      "patterns": [
        {
          "name": "constant.numeric.coordinate.iogl",
          "match": "@-?\\d+(\\.\\d+)?,\\s*-?\\d+(\\.\\d+)?"
        }
      ]
    }
  }
}
